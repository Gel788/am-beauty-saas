# Copy to deploy/.env and fill in. Never commit the real file.
DOMAIN=crm.example.ru
POSTGRES_PASSWORD=change-me-long-random
APP_DB_PASSWORD=change-me-another-long-random
JOBS_TOKEN=change-me-random-token
BACKUP_KEEP_DAYS=14
# Encrypts the keys salons enter in «Интеграции». 64 hex chars: openssl rand -hex 32.
# Keep a copy: without it the stored keys cannot be read and owners must re-enter them.
INTEGRATIONS_KEY=
# Platform-wide messaging (optional). Salons can connect their own bot and SMS gateway in «Интеграции».
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me-random-secret
SMS_RU_API_KEY=
SMS_SENDER=
