DATABASE_URL=postgresql://app_user:app_pass@127.0.0.1:5432/ambeauty
MIGRATE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ambeauty
# Secret for POST /api/jobs/reminders (cron). Leave empty to keep the endpoint closed.
JOBS_TOKEN=
# Encrypts integration keys (64 hex chars, openssl rand -hex 32). Optional in development.
INTEGRATIONS_KEY=
# Web push for the staff app (npx web-push generate-vapid-keys). Optional: without them a pair is made once and kept sealed by INTEGRATIONS_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Phase 4 · subscription. Without the shop keys invoices are paid in a sandbox (no money moves).
PLATFORM_YOOKASSA_SHOP_ID=
PLATFORM_YOOKASSA_SECRET_KEY=
# Emails of the platform team: they see «Платформа» with every salon (comma-separated).
PLATFORM_ADMIN_EMAILS=platform@ambeauty.local
